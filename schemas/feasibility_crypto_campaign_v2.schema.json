{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eqs.local/schemas/feasibility_crypto_campaign_v2.schema.json",
  "title": "EQS Feasibility Crypto Campaign V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "campaign", "campaign_fingerprint"],
  "properties": {
    "schema_id": {"const": "EQS-FEASIBILITY-CRYPTO-CAMPAIGN-V2"},
    "campaign_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id", "version", "classification", "purpose", "scope", "periods",
        "source_contract", "strategy", "execution_model", "research_rules",
        "shakedown_paper_gate", "promotion_prohibitions", "programme_exit_rule", "safety"
      ],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "version": {"const": "2.0.0"},
        "classification": {"const": "EXPLORATORY_NON_EVIDENTIARY"},
        "purpose": {"type": "string", "minLength": 1},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_class", "venue", "instrument", "bar_interval"],
          "properties": {
            "asset_class": {"const": "CRYPTO_LINEAR_PERPETUAL"},
            "venue": {"const": "BINANCE_USDM"},
            "instrument": {"const": "BTCUSDT"},
            "bar_interval": {"const": "5m"}
          }
        },
        "periods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["training_start", "training_end", "validation_start", "validation_end", "locked_oos_start", "locked_oos_end", "locked_oos_access"],
          "properties": {
            "training_start": {"const": "2023-01-01T00:00:00Z"},
            "training_end": {"const": "2025-06-30T23:59:59Z"},
            "validation_start": {"const": "2025-07-01T00:00:00Z"},
            "validation_end": {"const": "2026-03-31T23:59:59Z"},
            "locked_oos_start": {"const": "2026-04-01T00:00:00Z"},
            "locked_oos_end": {"const": "2026-09-21T23:59:59Z"},
            "locked_oos_access": {"const": "SEALED_NOT_PERMITTED"}
          }
        },
        "source_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "required_series", "monthly_archive_count", "full_object_sha256_required", "historical_pit_metadata_claim"],
          "properties": {
            "provider": {"const": "BINANCE_DATA_VISION_PUBLIC_ARCHIVE"},
            "required_series": {
              "type": "array",
              "prefixItems": [{"const": "KLINES_5M"}, {"const": "FUNDING_RATE"}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "monthly_archive_count": {"const": 39},
            "full_object_sha256_required": {"const": true},
            "historical_pit_metadata_claim": {"const": false}
          }
        },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "fast_bars", "slow_bars", "max_holding_bars", "direction", "parameter_tuning_allowed"],
          "properties": {
            "family": {"const": "SIMPLE_MOVING_AVERAGE_CROSSOVER"},
            "fast_bars": {"const": 12},
            "slow_bars": {"const": 48},
            "max_holding_bars": {"const": 12},
            "direction": {"const": "LONG_SHORT"},
            "parameter_tuning_allowed": {"const": false}
          }
        },
        "execution_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_time", "fill_time", "fee_bps_per_side", "adverse_slippage_bps_per_side", "same_bar_fill_allowed", "funding_treatment"],
          "properties": {
            "decision_time": {"const": "BAR_CLOSE"},
            "fill_time": {"const": "NEXT_BAR_OPEN"},
            "fee_bps_per_side": {"const": 5},
            "adverse_slippage_bps_per_side": {"const": 2},
            "same_bar_fill_allowed": {"const": false},
            "funding_treatment": {"const": "APPLY_ARCHIVED_FUNDING_WHEN_POSITION_SPANS_SETTLEMENT"}
          }
        },
        "research_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["single_fixed_configuration", "all_runs_counted", "empirical_outcomes_consumed", "may_write_r13_admission_ledger", "may_open_locked_oos"],
          "properties": {
            "single_fixed_configuration": {"const": true},
            "all_runs_counted": {"const": true},
            "empirical_outcomes_consumed": {"const": false},
            "may_write_r13_admission_ledger": {"const": false},
            "may_open_locked_oos": {"const": false}
          }
        },
        "shakedown_paper_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "minimum_completed_validation_trades", "requires_positive_validation_pnl", "requires_deterministic_replay", "requires_accounting_reconciliation", "counts_toward_168h_100_trade_gate"],
          "properties": {
            "classification": {"const": "SHAKEDOWN_NON_QUALIFYING"},
            "minimum_completed_validation_trades": {"const": 20},
            "requires_positive_validation_pnl": {"const": false},
            "requires_deterministic_replay": {"const": true},
            "requires_accounting_reconciliation": {"const": true},
            "counts_toward_168h_100_trade_gate": {"const": false}
          }
        },
        "promotion_prohibitions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["R13_CERTIFICATION", "J25_LOCKED_OOS", "J26_GENUINE_CANDIDATE", "LIVE_PROMOTION", "FORWARD_168H_100_TRADE_CREDIT"]}
        },
        "programme_exit_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_feasibility_campaigns", "max_elapsed_days", "on_no_candidate"],
          "properties": {
            "max_feasibility_campaigns": {"const": 3},
            "max_elapsed_days": {"const": 30},
            "on_no_candidate": {"const": "PAUSE_AND_REVIEW_HYPOTHESIS_OR_DATA_SCOPE_WITHOUT_WEAKENING_GATES"}
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["broker_submission_enabled", "live_authority", "options_included", "futures_dependency"],
          "properties": {
            "broker_submission_enabled": {"const": false},
            "live_authority": {"const": false},
            "options_included": {"const": false},
            "futures_dependency": {"const": false}
          }
        }
      }
    }
  }
}
