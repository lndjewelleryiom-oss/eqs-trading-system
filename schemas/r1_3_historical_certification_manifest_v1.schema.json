{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eqs.local/schemas/r1.3-historical-certification-manifest-v1.schema.json",
  "title": "EQS R1.3 Genuine Historical Certification Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "manifest_id",
    "manifest_generation",
    "created_at",
    "source_class",
    "environment",
    "dataset",
    "time_basis",
    "pit",
    "universe",
    "lifecycle",
    "coverage",
    "eligibility",
    "feature_binding",
    "validator",
    "rule_catalogue",
    "certification",
    "artifact_inventory",
    "provenance",
    "protected_boundary",
    "manifest_hash"
  ],
  "properties": {
    "schema_id": {
      "const": "EQS-R1.3-HISTORICAL-CERTIFICATION-MANIFEST-v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^r13m_[A-Za-z0-9._:-]{8,128}$"
    },
    "manifest_generation": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "#/$defs/dateTimeUtc"
    },
    "source_class": {
      "const": "GENUINE"
    },
    "environment": {
      "const": "RESEARCH"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "time_basis": {
      "$ref": "#/$defs/timeBasis"
    },
    "pit": {
      "$ref": "#/$defs/pit"
    },
    "universe": {
      "$ref": "#/$defs/universe"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "eligibility": {
      "$ref": "#/$defs/eligibility"
    },
    "feature_binding": {
      "$ref": "#/$defs/featureBinding"
    },
    "validator": {
      "$ref": "#/$defs/validator"
    },
    "rule_catalogue": {
      "$ref": "#/$defs/ruleCatalogue"
    },
    "certification": {
      "$ref": "#/$defs/certification"
    },
    "artifact_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "protected_boundary": {
      "$ref": "#/$defs/protectedBoundary"
    },
    "supersedes_manifest_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^r13m_[A-Za-z0-9._:-]{8,128}$"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "dateTimeUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "format_version",
        "builder_version",
        "dataset_manifest_fingerprint",
        "dataset_content_hash",
        "event_identity_hash",
        "replay_fingerprint",
        "partition_index_hash",
        "partition_count",
        "event_count",
        "coverage_start",
        "coverage_end",
        "decision_time",
        "venues",
        "instrument_type"
      ],
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dataset_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "format_version": {
          "const": "crypto-perps-research-v1"
        },
        "builder_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dataset_manifest_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "event_identity_hash": {
          "$ref": "#/$defs/sha256"
        },
        "replay_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "partition_index_hash": {
          "$ref": "#/$defs/sha256"
        },
        "partition_count": {
          "type": "integer",
          "minimum": 1
        },
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "coverage_start": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "coverage_end": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "decision_time": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "venues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BINANCE_USDM",
              "BYBIT_LINEAR",
              "OKX_SWAP"
            ]
          }
        },
        "instrument_type": {
          "const": "LINEAR_PERPETUAL"
        }
      }
    },
    "timeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "event_time_semantics",
        "publication_time_required",
        "effective_time_required",
        "available_at_required",
        "ingestion_time_recorded",
        "revision_time_recorded",
        "future_visibility_prohibited"
      ],
      "properties": {
        "timezone": {
          "const": "UTC"
        },
        "event_time_semantics": {
          "const": "AS_KNOWN_AT"
        },
        "publication_time_required": {
          "const": true
        },
        "effective_time_required": {
          "const": true
        },
        "available_at_required": {
          "const": true
        },
        "ingestion_time_recorded": {
          "const": true
        },
        "revision_time_recorded": {
          "const": true
        },
        "future_visibility_prohibited": {
          "const": true
        }
      }
    },
    "pit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "certification_id",
        "certification_sha256",
        "audit_version",
        "audit_generated_at",
        "records_checked",
        "violations",
        "future_events_detected",
        "future_revisions_detected",
        "survivorship_bias_detected",
        "backward_availability_adjustments",
        "decision_boundary_crossings"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "certification_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "certification_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audit_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audit_generated_at": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "records_checked": {
          "type": "integer",
          "minimum": 1
        },
        "violations": {
          "const": 0
        },
        "future_events_detected": {
          "const": 0
        },
        "future_revisions_detected": {
          "const": 0
        },
        "survivorship_bias_detected": {
          "const": false
        },
        "backward_availability_adjustments": {
          "const": 0
        },
        "decision_boundary_crossings": {
          "const": 0
        }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "snapshot_id",
        "snapshot_sha256",
        "universe_fingerprint",
        "record_count",
        "history_sha256",
        "point_in_time",
        "survivorship_free"
      ],
      "properties": {
        "schema_id": {
          "const": "EQS-H02-HISTORICAL-UNIVERSE-v1"
        },
        "snapshot_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "universe_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "history_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "point_in_time": {
          "const": true
        },
        "survivorship_free": {
          "const": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "record_count",
        "event_set_sha256",
        "listing_events_present",
        "delisting_events_present",
        "spec_revision_events_present",
        "source_revision_events_present",
        "continuity_status"
      ],
      "properties": {
        "schema_id": {
          "const": "EQS-H02-LIFECYCLE-EVENTS-v1"
        },
        "schema_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "event_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "listing_events_present": {
          "const": true
        },
        "delisting_events_present": {
          "const": true
        },
        "spec_revision_events_present": {
          "const": true
        },
        "source_revision_events_present": {
          "const": true
        },
        "continuity_status": {
          "const": "PASS"
        }
      }
    },
    "coverageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_id",
        "venue",
        "instrument_id",
        "series",
        "start_time",
        "end_time",
        "expected_intervals",
        "observed_intervals",
        "missing_intervals",
        "partial_intervals",
        "availability_status",
        "record_sha256"
      ],
      "properties": {
        "coverage_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "venue": {
          "enum": [
            "BINANCE_USDM",
            "BYBIT_LINEAR",
            "OKX_SWAP"
          ]
        },
        "instrument_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "series": {
          "enum": [
            "TRADES",
            "AGG_TRADES",
            "ORDERBOOK",
            "FUNDING",
            "MARK_PRICE",
            "INDEX_PRICE",
            "OPEN_INTEREST",
            "INSTRUMENT_METADATA",
            "LIQUIDATIONS"
          ]
        },
        "start_time": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "end_time": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "expected_intervals": {
          "type": "integer",
          "minimum": 0
        },
        "observed_intervals": {
          "type": "integer",
          "minimum": 0
        },
        "missing_intervals": {
          "type": "integer",
          "minimum": 0
        },
        "partial_intervals": {
          "type": "integer",
          "minimum": 0
        },
        "availability_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL_ALLOWED",
            "SOURCE_UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "coverage_record_set_sha256",
        "training_complete",
        "validation_complete",
        "locked_oos_complete",
        "records"
      ],
      "properties": {
        "schema_id": {
          "const": "EQS-H02-COVERAGE-v1"
        },
        "coverage_record_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "training_complete": {
          "const": true
        },
        "validation_complete": {
          "const": true
        },
        "locked_oos_complete": {
          "const": true
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coverageRecord"
          }
        }
      }
    },
    "eligibilityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility_id",
        "instrument_id",
        "venue",
        "effective_from",
        "effective_to",
        "eligible",
        "reason_codes",
        "source_universe_fingerprint",
        "record_sha256"
      ],
      "properties": {
        "eligibility_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instrument_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "venue": {
          "enum": [
            "BINANCE_USDM",
            "BYBIT_LINEAR",
            "OKX_SWAP"
          ]
        },
        "effective_from": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "effective_to": {
          "oneOf": [
            {
              "$ref": "#/$defs/dateTimeUtc"
            },
            {
              "type": "null"
            }
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_universe_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "eligibility_record_set_sha256",
        "record_count",
        "records"
      ],
      "properties": {
        "schema_id": {
          "const": "EQS-H02-ELIGIBILITY-v1"
        },
        "eligibility_record_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/eligibilityRecord"
          }
        }
      }
    },
    "featureBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_engine_version",
        "dataset_manifest_fingerprint",
        "universe_fingerprint",
        "feature_run_manifest_fingerprints",
        "feature_definition_hash"
      ],
      "properties": {
        "feature_engine_version": {
          "const": "crypto-perps-feature-engine-v1"
        },
        "dataset_manifest_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "universe_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "feature_run_manifest_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "feature_definition_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_id",
        "validator_version",
        "validator_build_sha256",
        "semantic_engine_version",
        "json_schema_version",
        "run_id",
        "run_started_at",
        "run_completed_at",
        "result"
      ],
      "properties": {
        "validator_id": {
          "const": "EQS-H02-R1.3-VALIDATOR"
        },
        "validator_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "validator_build_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_engine_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "json_schema_version": {
          "const": "2020-12"
        },
        "run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "run_started_at": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "run_completed_at": {
          "$ref": "#/$defs/dateTimeUtc"
        },
        "result": {
          "const": "PASS"
        }
      }
    },
    "ruleCatalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_id",
        "catalogue_version",
        "catalogue_sha256",
        "first_rule",
        "last_rule",
        "rule_count",
        "passed_rule_count",
        "failed_rule_count",
        "blocked_rule_count"
      ],
      "properties": {
        "catalogue_id": {
          "const": "EQS-H02-RR-CATALOGUE"
        },
        "catalogue_version": {
          "const": "RR-001-030-v1"
        },
        "catalogue_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "first_rule": {
          "const": "RR-001"
        },
        "last_rule": {
          "const": "RR-030"
        },
        "rule_count": {
          "const": 30
        },
        "passed_rule_count": {
          "const": 30
        },
        "failed_rule_count": {
          "const": 0
        },
        "blocked_rule_count": {
          "const": 0
        }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certification_run_id",
        "status",
        "a01_a28",
        "all_hard_gates_pass",
        "locked_oos_seal_intact",
        "dataset_immutable",
        "manifest_immutable"
      ],
      "properties": {
        "certification_run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "const": "PASSED"
        },
        "a01_a28": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 28,
          "maxProperties": 28,
          "patternProperties": {
            "^A(0[1-9]|1[0-9]|2[0-8])$": {
              "const": "PASS"
            }
          }
        },
        "all_hard_gates_pass": {
          "const": true
        },
        "locked_oos_seal_intact": {
          "const": true
        },
        "dataset_immutable": {
          "const": true
        },
        "manifest_immutable": {
          "const": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "path_or_uri",
        "sha256",
        "byte_size",
        "classification"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifact_type": {
          "enum": [
            "RAW_RECEIPT_INDEX",
            "RAW_OBJECT_INDEX",
            "DATASET_MANIFEST",
            "PARTITION_INDEX",
            "UNIVERSE_HISTORY",
            "UNIVERSE_SNAPSHOT",
            "LIFECYCLE_EVENT_SET",
            "COVERAGE_RECORD_SET",
            "ELIGIBILITY_RECORD_SET",
            "PIT_AUDIT",
            "REPLAY_REPORT",
            "DETERMINISM_REPORT",
            "FEATURE_RUN_MANIFEST",
            "HASH_INDEX",
            "VALIDATOR_REPORT",
            "RULE_CATALOGUE",
            "PROTECTED_BOUNDARY_REPORT",
            "OTHER"
          ]
        },
        "path_or_uri": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "classification": {
          "enum": [
            "REAL_MARKET",
            "DERIVED_REAL_MARKET"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h02_batch_manifest_sha256",
        "universe_snapshot_sha256",
        "lifecycle_event_schema_version",
        "lifecycle_event_set_sha256",
        "coverage_record_set_sha256",
        "eligibility_record_set_sha256",
        "validator_version",
        "validator_build_sha256",
        "rule_catalog_version",
        "rule_catalog_sha256",
        "pit_certification_sha256",
        "source_receipt_index_sha256",
        "parent_archive_sha256"
      ],
      "properties": {
        "h02_batch_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "universe_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lifecycle_event_schema_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "lifecycle_event_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coverage_record_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "eligibility_record_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validator_version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "validator_build_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rule_catalog_version": {
          "const": "RR-001-030-v1"
        },
        "rule_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pit_certification_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_receipt_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent_archive_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "protectedBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_submission_enabled",
        "credentials_accessed",
        "live_capital_touched",
        "protected_files_changed",
        "eqs06_options_included",
        "boundary_report_sha256"
      ],
      "properties": {
        "broker_submission_enabled": {
          "const": false
        },
        "credentials_accessed": {
          "const": false
        },
        "live_capital_touched": {
          "const": false
        },
        "protected_files_changed": {
          "const": 0
        },
        "eqs06_options_included": {
          "const": false
        },
        "boundary_report_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "x-eqs-semantic-rules": [
    "R13-M001",
    "R13-M002",
    "R13-M003",
    "R13-M004",
    "R13-M005",
    "R13-M006",
    "R13-M007",
    "R13-M008",
    "R13-M009",
    "R13-M010",
    "R13-M011",
    "R13-M012",
    "R13-M013",
    "R13-M014",
    "R13-M015",
    "R13-M016",
    "R13-M017",
    "R13-M018",
    "R13-M019",
    "R13-M020",
