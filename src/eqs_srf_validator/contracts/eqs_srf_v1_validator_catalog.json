{
  "aggregate_precedence": [
    "COMPROMISED",
    "INVALID",
    "BLOCK",
    "PASS"
  ],
  "catalog_version": "EQS-SRF-VALIDATOR-CATALOG-1.0",
  "default_behavior": {
    "candidate_mutation": "INVALID",
    "evaluation_mode": "FAIL_CLOSED",
    "hash_mismatch": "INVALID",
    "missing_reference": "BLOCK",
    "oos_access_control_breach": "COMPROMISED",
    "rule_execution_error": "BLOCK",
    "unknown_required_fact": "BLOCK"
  },
  "framework_version": "EQS-SRF-V1.0",
  "hash_contract": {
    "algorithm": "SHA-256",
    "canonicalization": "JCS-RFC8785",
    "encoding": "UTF-8",
    "hash_field_policy": "Exclude the object's own terminal hash field and any transport-only metadata explicitly designated non-semantic by the schema implementation."
  },
  "qualification_pass_condition": "All applicable FATAL/ERROR rules PASS or NOT_APPLICABLE; no COMPROMISED, INVALID or BLOCK result exists.",
  "rules": [
    {
      "description": "Campaign hash must recompute exactly.",
      "error_code": "EQS-SRF-CAMPAIGN-HASH-MISMATCH",
      "evidence_required": [],
      "inputs": "campaign",
      "on_fail": "INVALID",
      "phase": "REGISTER",
      "predicate": "campaign_hash == canonical_hash(campaign)",
      "rule_id": "SRF-CAM-001",
      "scope": "EQSResearchCampaign",
      "severity": "FATAL"
    },
    {
      "description": "Research, validation and OOS ranges must be non-overlapping and strictly ordered.",
      "error_code": "EQS-SRF-CAMPAIGN-DATE-PARTITION-INVALID",
      "evidence_required": [],
      "inputs": [
        "campaign.date_ranges"
      ],
      "on_fail": "BLOCK",
      "phase": "REGISTER",
      "predicate": "research.start < research.end <= validation.start < validation.end <= oos.start < oos.end",
      "rule_id": "SRF-CAM-002",
      "scope": "EQSResearchCampaign",
      "severity": "FATAL"
    },
    {
      "description": "A REGISTERED-or-later campaign cannot be changed in place.",
      "error_code": "EQS-SRF-CAMPAIGN-IMMUTABILITY-VIOLATION",
      "evidence_required": [],
      "inputs": [
        "prior_campaign",
        "candidate_campaign"
      ],
      "on_fail": "INVALID",
      "phase": "MUTATION",
      "predicate": "prior.status in ['DRAFT','PREREGISTRATION_PENDING'] or canonical_semantics(prior)==canonical_semantics(candidate)",
      "rule_id": "SRF-CAM-003",
      "scope": "EQSResearchCampaign",
      "severity": "FATAL"
    },
    {
      "description": "Execution and cost models must cover every campaign asset class.",
      "error_code": "EQS-SRF-CAMPAIGN-ASSET-MODEL-INCOMPATIBLE",
      "evidence_required": [],
      "inputs": [
        "campaign",
        "execution_model",
        "cost_model"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "set(campaign.asset_classes) <= set(execution_model.asset_classes) and set(campaign.asset_classes) <= set(cost_model.asset_classes)",
      "rule_id": "SRF-CAM-004",
      "scope": "EQSResearchCampaign",
      "severity": "FATAL"
    },
    {
      "description": "OOS authorization requires candidate status SEALED.",
      "error_code": "EQS-SRF-CANDIDATE-NOT-SEALED",
      "evidence_required": [],
      "inputs": [
        "candidate.status"
      ],
      "on_fail": "BLOCK",
      "phase": "CANDIDATE_FREEZE",
      "predicate": "candidate.status == 'SEALED'",
      "rule_id": "SRF-CAN-001",
      "scope": "EQSCandidateSeal",
      "severity": "FATAL"
    },
    {
      "description": "Candidate hash must recompute from all frozen semantic dependencies.",
      "error_code": "EQS-SRF-CANDIDATE-HASH-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "candidate",
        "resolved_dependencies"
      ],
      "on_fail": "INVALID",
      "phase": "CANDIDATE_FREEZE",
      "predicate": "candidate.candidate_hash == canonical_candidate_hash(candidate,resolved_dependencies)",
      "rule_id": "SRF-CAN-002",
      "scope": "EQSCandidateSeal",
      "severity": "FATAL"
    },
    {
      "description": "SEALED candidate semantics are immutable.",
      "error_code": "EQS-SRF-CANDIDATE-MUTATED-AFTER-FREEZE",
      "evidence_required": [],
      "inputs": [
        "prior_candidate",
        "candidate"
      ],
      "on_fail": "INVALID",
      "phase": "MUTATION",
      "predicate": "prior.status not in ['SEALED','OOS_CONSUMED'] or canonical_semantics(prior)==canonical_semantics(candidate)",
      "rule_id": "SRF-CAN-003",
      "scope": "EQSCandidateSeal",
      "severity": "FATAL"
    },
    {
      "description": "Candidate must remain identical after OOS open.",
      "error_code": "EQS-SRF-CANDIDATE-MUTATED-AFTER-OOS-OPEN",
      "evidence_required": [],
      "inputs": [
        "candidate_at_open",
        "candidate_at_completion"
      ],
      "on_fail": "INVALID",
      "phase": "OOS",
      "predicate": "candidate_at_open.candidate_hash == candidate_at_completion.candidate_hash",
      "rule_id": "SRF-CAN-004",
      "scope": "EQSCandidateSeal",
      "severity": "FATAL"
    },
    {
      "description": "Frozen research evidence manifest hash must resolve exactly.",
      "error_code": "EQS-SRF-CANDIDATE-EVIDENCE-MANIFEST-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "candidate.research_evidence_manifest_hash",
        "evidence_manifest"
      ],
      "on_fail": "INVALID",
      "phase": "CANDIDATE_FREEZE",
      "predicate": "candidate.research_evidence_manifest_hash == evidence_manifest.manifest_hash",
      "rule_id": "SRF-CAN-005",
      "scope": "EQSCandidateSeal",
      "severity": "FATAL"
    },
    {
      "description": "Canonical qualification runs require a clean worktree.",
      "error_code": "EQS-SRF-CODE-DIRTY-WORKTREE",
      "evidence_required": [],
      "inputs": [
        "code_binding.dirty_worktree"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "dirty_worktree == false",
      "rule_id": "SRF-COD-001",
      "scope": "EQSCodeBinding",
      "severity": "FATAL"
    },
    {
      "description": "Executed commit, tree and dependency lock must equal the code binding.",
      "error_code": "EQS-SRF-CODE-BINDING-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "code_binding",
        "runtime_code_identity"
      ],
      "on_fail": "INVALID",
      "phase": "EXECUTE",
      "predicate": "runtime_code_identity == bound_code_identity(code_binding)",
      "rule_id": "SRF-COD-002",
      "scope": "EQSCodeBinding",
      "severity": "FATAL"
    },
    {
      "description": "A valid cost model must be bound to every campaign.",
      "error_code": "EQS-SRF-COST-MODEL-MISSING",
      "evidence_required": [],
      "inputs": [
        "campaign.cost_model_id",
        "cost_model_registry"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "resolve(campaign.cost_model_id) != null",
      "rule_id": "SRF-CST-001",
      "scope": "EQSResearchCampaign",
      "severity": "FATAL"
    },
    {
      "description": "Cost model must be effective for each simulated execution timestamp.",
      "error_code": "EQS-SRF-COST-MODEL-NOT-EFFECTIVE",
      "evidence_required": [],
      "inputs": [
        "cost_model",
        "fills"
      ],
      "on_fail": "BLOCK",
      "phase": "BACKTEST",
      "predicate": "all(effective_from <= fill.execution_time < effective_to_or_infinity for fill in fills)",
      "rule_id": "SRF-CST-002",
      "scope": "EQSCostModel",
      "severity": "FATAL"
    },
    {
      "description": "Cost model must support the executed asset class.",
      "error_code": "EQS-SRF-COST-ASSET-INCOMPATIBLE",
      "evidence_required": [],
      "inputs": [
        "cost_model.asset_classes",
        "fills"
      ],
      "on_fail": "BLOCK",
      "phase": "BACKTEST",
      "predicate": "all(asset_class(fill.instrument_id) in cost_model.asset_classes for fill in fills)",
      "rule_id": "SRF-CST-003",
      "scope": "EQSCostModel",
      "severity": "FATAL"
    },
    {
      "description": "Total costs may be zero only if produced explicitly by a nonzero-capable model for that event, never because the model is absent.",
      "error_code": "EQS-SRF-COST-ZERO-DEFAULT",
      "evidence_required": [],
      "inputs": [
        "cost_model",
        "fills"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "cost_model exists and no_implicit_zero_default(fills,cost_model)",
      "rule_id": "SRF-CST-004",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Every fold must have strictly ordered train and validation intervals.",
      "error_code": "EQS-SRF-CV-FOLD-ORDER-INVALID",
      "evidence_required": [],
      "inputs": [
        "cv_spec.folds"
      ],
      "on_fail": "BLOCK",
      "phase": "REGISTER",
      "predicate": "all(f.train.start < f.train.end <= f.validation.start < f.validation.end for f in folds)",
      "rule_id": "SRF-CV-001",
      "scope": "EQSCrossValidationSpec",
      "severity": "FATAL"
    },
    {
      "description": "Train and validation observations must not overlap after purge handling.",
      "error_code": "EQS-SRF-CV-TRAIN-VALIDATION-OVERLAP",
      "evidence_required": [],
      "inputs": [
        "cv_spec.folds"
      ],
      "on_fail": "BLOCK",
      "phase": "REGISTER",
      "predicate": "no_forbidden_overlap(folds)",
      "rule_id": "SRF-CV-002",
      "scope": "EQSCrossValidationSpec",
      "severity": "FATAL"
    },
    {
      "description": "Purged CV must satisfy maximum bound label horizon and preregistered purge requirements.",
      "error_code": "EQS-SRF-CV-PURGE-INSUFFICIENT",
      "evidence_required": [],
      "inputs": [
        "cv_spec",
        "labels"
      ],
      "on_fail": "BLOCK",
      "phase": "REGISTER",
      "predicate": "method not in ['PURGED','PURGED_EMBARGOED'] or purge_interval >= max_required_purge(labels)",
      "rule_id": "SRF-CV-003",
      "scope": "EQSCrossValidationSpec",
      "severity": "FATAL"
    },
    {
      "description": "Purged-and-embargoed CV must satisfy maximum bound embargo requirement.",
      "error_code": "EQS-SRF-CV-EMBARGO-INSUFFICIENT",
      "evidence_required": [],
      "inputs": [
        "cv_spec",
        "labels"
      ],
      "on_fail": "BLOCK",
      "phase": "REGISTER",
      "predicate": "method != 'PURGED_EMBARGOED' or embargo_interval >= max_required_embargo(labels)",
      "rule_id": "SRF-CV-004",
      "scope": "EQSCrossValidationSpec",
      "severity": "FATAL"
    },
    {
      "description": "Temporal CV cannot be shuffled.",
      "error_code": "EQS-SRF-CV-SHUFFLE-PROHIBITED",
      "evidence_required": [],
      "inputs": [
        "cv_spec.shuffle"
      ],
      "on_fail": "BLOCK",
      "phase": "REGISTER",
      "predicate": "shuffle == false",
      "rule_id": "SRF-CV-005",
      "scope": "EQSCrossValidationSpec",
      "severity": "FATAL"
    },
    {
      "description": "Qualification requires fully certified PIT data.",
      "error_code": "EQS-SRF-DATA-PIT-NOT-CERTIFIED",
      "evidence_required": [],
      "inputs": [
        "data_binding.pit_certification_status"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "pit_certification_status == 'CERTIFIED'",
      "rule_id": "SRF-DAT-001",
      "scope": "EQSDataBinding",
      "severity": "FATAL"
    },
    {
      "description": "Every market-data certification ID must resolve.",
      "error_code": "EQS-SRF-DATA-CERTIFICATION-MISSING",
      "evidence_required": [],
      "inputs": [
        "data_binding.market_data_certification_ids"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "all(resolve(id) for id in market_data_certification_ids)",
      "rule_id": "SRF-DAT-002",
      "scope": "EQSDataBinding",
      "severity": "FATAL"
    },
    {
      "description": "Bound dataset manifest hash must equal immutable snapshot manifest hash.",
      "error_code": "EQS-SRF-DATA-MANIFEST-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "data_binding.dataset_manifest_hash",
        "dataset_manifest"
      ],
      "on_fail": "INVALID",
      "phase": "QUALIFICATION",
      "predicate": "dataset_manifest_hash == sha256(dataset_manifest)",
      "rule_id": "SRF-DAT-003",
      "scope": "EQSDataBinding",
      "severity": "FATAL"
    },
    {
      "description": "All bound source snapshot hashes must match the immutable source snapshots used by the dataset manifest.",
      "error_code": "EQS-SRF-DATA-SOURCE-SNAPSHOT-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "data_binding.source_snapshot_hashes",
        "source_snapshots"
      ],
      "on_fail": "INVALID",
      "phase": "QUALIFICATION",
      "predicate": "set(data_binding.source_snapshot_hashes) == set(recompute_source_snapshot_hashes(source_snapshots))",
      "rule_id": "SRF-DAT-004",
      "scope": "EQSDataBinding",
      "severity": "FATAL"
    },
    {
      "description": "Runtime environment must equal the bound runtime identity.",
      "error_code": "EQS-SRF-ENVIRONMENT-BINDING-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "environment_binding",
        "runtime_environment_identity"
      ],
      "on_fail": "INVALID",
      "phase": "EXECUTE",
      "predicate": "runtime_environment_identity == bound_environment_identity(environment_binding)",
      "rule_id": "SRF-ENV-001",
      "scope": "EQSEnvironmentBinding",
      "severity": "FATAL"
    },
    {
      "description": "Canonical evidence requires at least D2 unless the campaign explicitly requires a stronger profile.",
      "error_code": "EQS-SRF-DETERMINISM-INSUFFICIENT",
      "evidence_required": [],
      "inputs": [
        "environment_binding.determinism_profile_id",
        "campaign"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "determinism_rank(profile) >= max(2, campaign_required_determinism_rank(campaign))",
      "rule_id": "SRF-ENV-002",
      "scope": "EQSEnvironmentBinding",
      "severity": "ERROR"
    },
    {
      "description": "Campaign execution model must resolve and be version-fixed.",
      "error_code": "EQS-SRF-EXECUTION-MODEL-MISSING",
      "evidence_required": [],
      "inputs": [
        "campaign.execution_model_id",
        "execution_model_registry"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "resolve(campaign.execution_model_id) != null",
      "rule_id": "SRF-EXE-001",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Execution model must support every instrument/asset used by the experiment.",
      "error_code": "EQS-SRF-EXECUTION-ASSET-INCOMPATIBLE",
      "evidence_required": [],
      "inputs": [
        "execution_model",
        "experiment_instruments"
      ],
      "on_fail": "BLOCK",
      "phase": "QUALIFICATION",
      "predicate": "all(asset_class(i) in execution_model.asset_classes for i in experiment_instruments)",
      "rule_id": "SRF-EXE-002",
      "scope": "EQSExecutionModelDefinition",
      "severity": "FATAL"
    },
    {
      "description": "All lifecycle events required by the asset adapter must be handled.",
      "error_code": "EQS-SRF-ASSET-LIFECYCLE-NOT-MODELED",
      "evidence_required": [],
      "inputs": [
        "execution_model.lifecycle_handlers",
        "asset_adapter.required_lifecycle_handlers"
      ],
      "on_fail": "INVALID",
      "phase": "BACKTEST",
      "predicate": "set(required_lifecycle_handlers) <= set(execution_model.lifecycle_handlers)",
      "rule_id": "SRF-EXE-003",
      "scope": "EQSExecutionModelDefinition",
      "severity": "FATAL"
    },
    {
      "description": "Experiment campaign ID/hash must match canonical campaign.",
      "error_code": "EQS-SRF-EXPERIMENT-CAMPAIGN-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "experiment",
        "campaign"
      ],
      "on_fail": "INVALID",
      "phase": "EXECUTE",
      "predicate": "experiment.campaign_id == campaign.campaign_id and experiment.campaign_hash == campaign.campaign_hash",
      "rule_id": "SRF-EXP-001",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Experiment preregistration ID/hash must match canonical preregistration.",
      "error_code": "EQS-SRF-EXPERIMENT-PREREG-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "experiment",
        "preregistration"
      ],
      "on_fail": "INVALID",
      "phase": "EXECUTE",
      "predicate": "experiment.preregistration_id == preregistration.preregistration_id and experiment.preregistration_hash == preregistration.canonical_payload_hash",
      "rule_id": "SRF-EXP-002",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Canonical experiment strategy family must be preregistered.",
      "error_code": "EQS-SRF-PREREG-UNDECLARED-STRATEGY",
      "evidence_required": [],
      "inputs": [
        "experiment",
        "strategy_definition",
        "preregistration"
      ],
      "on_fail": "BLOCK",
      "phase": "EXECUTE",
      "predicate": "strategy_definition.strategy_family_id in preregistration.strategy_families[*].strategy_family_id",
      "rule_id": "SRF-EXP-003",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Canonical experiment features must be preregistered unless experiment_class is EXPLORATORY or DIAGNOSTIC.",
      "error_code": "EQS-SRF-PREREG-UNDECLARED-FEATURE",
      "evidence_required": [],
      "inputs": [
        "experiment",
        "preregistration"
      ],
      "on_fail": "BLOCK",
      "phase": "EXECUTE",
      "predicate": "experiment_class in ['EXPLORATORY','DIAGNOSTIC'] or all(binding in preregistration.feature_sets for binding in experiment.feature_bindings)",
      "rule_id": "SRF-EXP-004",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Canonical experiment labels must be preregistered unless experiment_class is EXPLORATORY or DIAGNOSTIC.",
      "error_code": "EQS-SRF-PREREG-UNDECLARED-LABEL",
      "evidence_required": [],
      "inputs": [
        "experiment",
        "preregistration"
      ],
      "on_fail": "BLOCK",
      "phase": "EXECUTE",
      "predicate": "experiment_class in ['EXPLORATORY','DIAGNOSTIC'] or all(binding in preregistration.labels for binding in experiment.label_bindings)",
      "rule_id": "SRF-EXP-005",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Confirmatory/OOS parameters must lie inside preregistered ranges.",
      "error_code": "EQS-SRF-PREREG-PARAMETER-OUT-OF-BOUNDS",
      "evidence_required": [],
      "inputs": [
        "experiment.parameter_set",
        "preregistration"
      ],
      "on_fail": "BLOCK",
      "phase": "EXECUTE",
      "predicate": "experiment_class in ['EXPLORATORY','DIAGNOSTIC'] or parameters_within_preregistered_domain(experiment,preregistration)",
      "rule_id": "SRF-EXP-006",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Phase data consumption must stay inside the authorized campaign date partition.",
      "error_code": "EQS-SRF-EXPERIMENT-PHASE-DATE-VIOLATION",
      "evidence_required": [],
      "inputs": [
        "experiment.research_phase",
        "data_lineage",
        "campaign.date_ranges"
      ],
      "on_fail": "INVALID",
      "phase": "BACKTEST",
      "predicate": "consumed_data_times within authorized_range(experiment.research_phase,campaign)",
      "rule_id": "SRF-EXP-007",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Experiment sequence must be unique within campaign.",
      "error_code": "EQS-SRF-EXPERIMENT-SEQUENCE-CONFLICT",
      "evidence_required": [],
      "inputs": [
        "experiment.campaign_id",
        "experiment.experiment_sequence",
        "experiment_registry"
      ],
      "on_fail": "BLOCK",
      "phase": "REGISTER",
      "predicate": "unique(campaign_id,experiment_sequence)",
      "rule_id": "SRF-EXP-008",
      "scope": "EQSExperiment",
      "severity": "ERROR"
    },
    {
      "description": "Canonical experiment provenance must resolve code, data, environment, strategy, feature, label and parameter identities.",
      "error_code": "EQS-SRF-EXPERIMENT-PROVENANCE-INCOMPLETE",
      "evidence_required": [],
      "inputs": [
        "experiment",
        "registries"
      ],
      "on_fail": "INVALID",
      "phase": "QUALIFICATION",
      "predicate": "complete_provenance(experiment,registries) == true",
      "rule_id": "SRF-EXP-009",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Every bound feature definition/version/hash must resolve exactly.",
      "error_code": "EQS-SRF-FEATURE-DEFINITION-MISSING",
      "evidence_required": [],
      "inputs": [
        "experiment.feature_bindings",
        "feature_registry"
      ],
      "on_fail": "BLOCK",
      "phase": "EXECUTE",
      "predicate": "all(resolve_exact_feature(b) for b in experiment.feature_bindings)",
      "rule_id": "SRF-FEA-001",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "A feature ID/version cannot map to more than one semantic definition hash.",
      "error_code": "EQS-SRF-FEATURE-SEMANTIC-ID-REUSE",
      "evidence_required": [],
      "inputs": [
        "feature_registry"
      ],
      "on_fail": "INVALID",
      "phase": "REGISTRY",
      "predicate": "unique(feature_id,feature_version) -> exactly_one(definition_hash)",
      "rule_id": "SRF-FEA-002",
      "scope": "EQSFeatureDefinition",
      "severity": "FATAL"
    },
    {
      "description": "All information used in the feature snapshot must be knowable by the decision information cutoff.",
      "error_code": "EQS-SRF-FEATURE-KNOWN-FROM-VIOLATION",
      "evidence_required": [],
      "inputs": [
        "decision",
        "feature_snapshot_lineage"
      ],
      "on_fail": "INVALID",
      "phase": "BACKTEST",
      "predicate": "max(feature_snapshot_lineage.known_from) <= decision.information_cutoff",
      "rule_id": "SRF-FEA-003",
      "scope": "EQSDecision",
      "severity": "FATAL"
    },
    {
      "description": "Each experiment feature binding hash must match the registered immutable feature definition.",
      "error_code": "EQS-SRF-FEATURE-DEFINITION-HASH-MISMATCH",
      "evidence_required": [],
      "inputs": [
        "experiment.feature_bindings",
        "feature_registry"
      ],
      "on_fail": "INVALID",
      "phase": "EXECUTE",
      "predicate": "all(binding.definition_hash == resolve_feature(binding).definition_hash for binding in experiment.feature_bindings)",
      "rule_id": "SRF-FEA-004",
      "scope": "EQSExperiment",
      "severity": "FATAL"
    },
    {
      "description": "Object must validate against the declared Draft 2020-12 schema.",
